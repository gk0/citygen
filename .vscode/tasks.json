{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "configure",
        "type": "shell",
        "command": "cmake",
        "args": ["-S", ".", "-B", "build"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": [],
        "detail": "CMake configure (also regenerates compile_commands.json)"
      },
      {
        "label": "build",
        "type": "shell",
        "command": "cmake",
        "args": ["--build", "build", "--parallel"],
        "options": { "cwd": "${workspaceFolder}" },
        "dependsOn": "configure",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$gcc"],
        "detail": "Full CMake build"
      },
      {
        "label": "run",
        "type": "shell",
        "command": "./citygen",
        "options": { "cwd": "${workspaceFolder}/build/runtime", "env": { "GDK_BACKEND": "x11" } },
        "dependsOn": "build",
        "problemMatcher": [],
        "detail": "Run citygen from the staged runtime dir (Media + OGRE plugins)"
      }
    ]
}
