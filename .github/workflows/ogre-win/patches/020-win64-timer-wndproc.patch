Fix Win64 issues in OgreTimer and OgreWindowEventUtilities.

- OgreTimer::setOption: GetProcessAffinityMask takes PDWORD_PTR; the old
  MSVC-only _M_X64 branch cast DWORD* to PDWORD_PTR, writing 64 bits into
  32-bit variables. Use DWORD_PTR unconditionally (as reset() already does).
- OgreWindowEventUtilities::_WndProc: SetWindowLongPtr stores a pointer in
  GWLP_USERDATA; casting it to LONG truncated it on Win64.
--- a/OgreMain/src/WIN32/OgreTimer.cpp
+++ b/OgreMain/src/WIN32/OgreTimer.cpp
@@ -52,13 +52,11 @@
 		DWORD newTimerMask = * static_cast < const DWORD * > ( val );
 
 		// Get the current process core mask
-		DWORD procMask;
-		DWORD sysMask;
-#if _MSC_VER >= 1400 && defined (_M_X64)
-		GetProcessAffinityMask(GetCurrentProcess(), (PDWORD_PTR)&procMask, (PDWORD_PTR)&sysMask);
-#else
+		// (DWORD_PTR: GetProcessAffinityMask takes PDWORD_PTR, and the old
+		// MSVC-only _M_X64 branch wrote 64 bits into 32-bit variables)
+		DWORD_PTR procMask;
+		DWORD_PTR sysMask;
 		GetProcessAffinityMask(GetCurrentProcess(), &procMask, &sysMask);
-#endif
 
 		// If new mask is 0, then set to default behavior, otherwise check
 		// to make sure new timer core mask overlaps with process core mask
--- a/OgreMain/src/OgreWindowEventUtilities.cpp
+++ b/OgreMain/src/OgreWindowEventUtilities.cpp
@@ -142,7 +142,7 @@
 {
 	if (uMsg == WM_CREATE)
 	{	// Store pointer to Win32Window in user data area
-		SetWindowLongPtr(hWnd, GWLP_USERDATA, (LONG)(((LPCREATESTRUCT)lParam)->lpCreateParams));
+		SetWindowLongPtr(hWnd, GWLP_USERDATA, (LONG_PTR)(((LPCREATESTRUCT)lParam)->lpCreateParams));
 		return 0;
 	}
 
